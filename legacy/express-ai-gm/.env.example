# Copy to .env and edit. Everything here is optional in mock mode.

# mock = canned responses, no network, no key needed (default)
# live = real AI Game Master via the Anthropic API
GM_MODE=mock

# Required only when GM_MODE=live
ANTHROPIC_API_KEY=

# Which Claude model the live GM uses, and how hard it thinks.
# Lower effort = faster rounds. Try claude-haiku-4-5 if rounds feel slow
# (note: Haiku ignores GM_EFFORT).
GM_MODEL=claude-sonnet-5
GM_EFFORT=medium

# Fake "thinking" delay for mock mode, in ms, so the loading screen is visible.
GM_MOCK_DELAY_MS=600

PORT=3000
