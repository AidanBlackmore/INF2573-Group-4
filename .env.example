# Supabase dashboard > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: PostHog analytics. Leave empty to skip analytics.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional: "Give feedback" link on the host screen. Leave empty to hide it.
FEEDBACK_URL=

# Optional: the address the TV's QR code and "or go to" line point phones at.
# Defaults to https://inf-2573-group-4.vercel.app. Set it to your laptop's address to test phones on a local network.
NEXT_PUBLIC_SITE_URL=
