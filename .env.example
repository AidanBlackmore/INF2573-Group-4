# Supabase dashboard > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: PostHog analytics. Leave empty to skip analytics.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional: "Give feedback" link on the host screen. Leave empty to hide it.
FEEDBACK_URL=

# Optional: the address the TV's QR code and "or go to" line point phones at.
# Defaults to https://the-gatheringg.vercel.app. Set it to your laptop's address to test phones on a local network.
NEXT_PUBLIC_SITE_URL=

# Optional: Cloudflare Workers AI (free plan) for drawing players' portraits. Server only.
# Without them every player gets a pre-drawn portrait. See "Character portraits" in the README.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
